# Maintainer: Abdulrahman <mail@abdulrahman.dev>
#
# Zaun from the release tarball (PKG-002); AUR package `zaun-bin`.
# The release workflow fills in pkgver and sha256sums for each release.

pkgname=zaun-bin
_pkgname=zaun
pkgver=0.1.0
# The tag's version; pacman versions cannot contain "-" (1.0.0-rc.1 -> pkgver 1.0.0rc.1).
_upstreamver=0.1.0
pkgrel=1
pkgdesc='Run Windows games through umu-launcher in a per-game bubblewrap sandbox (release binary)'
arch=('x86_64')
url='https://github.com/abdulrahman1s/zaun'
license=('GPL-3.0-or-later' 'AGPL-3.0-only' 'LGPL-2.1-or-later' 'LGPL-3.0-or-later' 'OFL-1.1' 'MIT' 'Apache-2.0')
depends=(
  'bubblewrap'
  'umu-launcher'
  'gcc-libs'
  'glibc'
  'hicolor-icon-theme'
  'libxkbcommon'
  'libva'
  'libpipewire'
  'libpulse'
  'opus'
  'systemd-libs'
  'vulkan-icd-loader'
  'wayland'
)
optdepends=(
  'mangohud: performance overlay in games'
  'gamescope: run games in a gamescope session'
  'xdg-desktop-portal: native file chooser'
  'xdg-utils: open folders and links from Zaun'
  'libx11: X11 sessions'
  'libxcursor: X11 sessions'
  'libxi: X11 sessions'
  'libxrandr: X11 sessions'
  'libglvnd: OpenGL when Vulkan is unavailable'
)
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
options=('!strip' '!debug')
source=("$url/releases/download/v$_upstreamver/$_pkgname-$_upstreamver-x86_64-linux.tar.zst")
sha256sums=('SKIP')

package() {
  cd "$_pkgname-$_upstreamver-x86_64-linux"
  # The release binary finds its shim and helpers next to itself.
  local f
  for f in zaun zaun-init zaun-overlay zaun-chat; do
    install -Dm755 "libexec/zaun/$f" "$pkgdir/usr/lib/zaun/$f"
  done
  install -d "$pkgdir/usr/bin"
  ln -s ../lib/zaun/zaun "$pkgdir/usr/bin/zaun"
  cp -R --no-preserve=ownership share "$pkgdir/usr/"
}
