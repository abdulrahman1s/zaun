---
source: crates/easyplay-core/tests/sandbox_golden.rs
expression: run_cell(c)
---
--unshare-user
--unshare-pid
--unshare-uts
--unshare-cgroup-try
--hostname easyplay
--die-with-parent
--new-session
--json-status-fd 4
--sync-fd 5
--seccomp 7
--ro-bind /usr /usr
--ro-bind /bin /bin
--ro-bind-try /opt /opt
--ro-bind /nix /nix
--ro-bind /run/current-system /run/current-system
--ro-bind-try /run/opengl-driver /run/opengl-driver
--ro-bind-try /run/opengl-driver-32 /run/opengl-driver-32
--ro-bind-try /etc/static /etc/static
--ro-bind-try /etc/profiles/per-user/sam /etc/profiles/per-user/sam
--dir /var
--symlink ../run /var/run
--perms 1777 --tmpfs /var/tmp
--ro-bind-try /var/cache/fontconfig /var/cache/fontconfig
--dir /etc
--ro-bind-try /nix/store/x1-etc/etc/fonts /etc/fonts
--ro-bind-try /nix/store/x1-etc/etc/os-release /etc/os-release
--ro-bind-try /nix/store/t1-tzdata/share/zoneinfo/Europe/Berlin /etc/localtime
--ro-bind-try /nix/store/t1-tzdata/share/zoneinfo /etc/zoneinfo
--perms 0444 --ro-bind-data 8 /etc/passwd
--perms 0444 --ro-bind-data 9 /etc/group
--perms 0444 --ro-bind-data 10 /etc/nsswitch.conf
--perms 0444 --file 11 /etc/machine-id
--ro-bind /nix/store/x1-etc/etc/hosts /etc/hosts
--ro-bind /etc/resolv.conf /etc/resolv.conf
--ro-bind-try /nix/store/x1-etc/etc/ssl /etc/ssl
--proc /proc
--dev /dev
--dev-bind /dev/dri /dev/dri
--dev-bind-try /dev/ntsync /dev/ntsync
--ro-bind /sys/block /sys/block
--ro-bind /sys/bus /sys/bus
--ro-bind /sys/class /sys/class
--ro-bind /sys/dev /sys/dev
--ro-bind /sys/devices /sys/devices
--tmpfs /sys/class/net
--tmpfs /sys/devices/pci0000:00/0000:00:1f.6/net
--tmpfs /sys/devices/virtual/net
--tmpfs /sys/devices/virtual/dmi
--tmpfs /sys/class/dmi
--perms 1777 --size 67108864 --tmpfs /tmp
--dir /run
--perms 0700 --tmpfs /run/user/1000
--dir /run/easyplay
--dir /tmp/.X11-unix
--ro-bind /tmp/.X11-unix/X0 /tmp/.X11-unix/X0
--ro-bind /run/user/1000/.mutter-Xwaylandauth.A1B2C3 /run/user/1000/easyplay-xauth
--ro-bind /run/user/1000/wayland-0 /run/user/1000/wayland-0
--perms 0700 --tmpfs /home/sam
--ro-bind-try /home/sam/.local/share/fonts /home/sam/.local/share/fonts
--bind D/runtimes/umu /home/sam/.local/share/umu
--bind D/runtimes/Steam/compatibilitytools.d /home/sam/.local/share/Steam/compatibilitytools.d
--bind /home/sam/.cache/easyplay/umu /home/sam/.cache/umu
--perms 0700 --tmpfs /tmp/easyplay-prefix
--ro-bind /usr/libexec/easyplay/easyplay-init /run/easyplay/init
--clearenv
--setenv DISPLAY :0
--setenv GAMEID umu-default
--setenv GST_DEBUG 0
--setenv HOME /home/sam
--setenv LANG en_US.UTF-8
--setenv LOGNAME sam
--setenv PATH /run/current-system/sw/bin:/usr/bin:/bin
--setenv PRESSURE_VESSEL_SHARE_HOME 1
--setenv PROTONPATH GE-Proton
--setenv USER sam
--setenv WAYLAND_DISPLAY wayland-0
--setenv WINEPREFIX /tmp/easyplay-prefix
--setenv XAUTHORITY /run/user/1000/easyplay-xauth
--setenv XDG_CURRENT_DESKTOP GNOME
--setenv XDG_RUNTIME_DIR /run/user/1000
--setenv XDG_SESSION_TYPE wayland
--chdir /home/sam
-- /run/easyplay/init --status-fd 6 -- /run/current-system/sw/bin/umu-run ""

# descriptors
7  <seccomp program>
8 /etc/passwd sam:x:1000:1000:sam:/home/sam:/bin/sh\nnobody:x:65534:65534:nobody:/:/usr/sbin/nologin\n
9 /etc/group sam:x:1000:\nnobody:x:65534:\n
10 /etc/nsswitch.conf passwd: files\ngroup: files\nhosts: files dns\n
11 /etc/machine-id 0123456789abcdef0123456789abcdef\n

# host actions
{"create_dir":{"path":"D/runtimes/umu","mode":448}}
{"create_dir":{"path":"D/runtimes/Steam/compatibilitytools.d","mode":448}}
{"create_dir":{"path":"/home/sam/.cache/easyplay/umu","mode":448}}
{"write_memfd":{"fd":3}}
{"write_memfd":{"fd":7}}
{"write_memfd":{"fd":8}}
{"write_memfd":{"fd":9}}
{"write_memfd":{"fd":10}}
{"write_memfd":{"fd":11}}

# notes
note.ipc.shared: Shared memory is shared with the display server so X11 rendering works

# issues
