{"create_dir":{"path":"D/games/G/home","mode":448}}
{"create_dir":{"path":"D/runtimes/session-var/S","mode":448}}
{"create_dir":{"path":"D/games/G/prefix","mode":448}}
{"acquire_lock":{"path":"D/games/G/session.lock"}}
{"write_memfd":{"fd":3}}
{"write_memfd":{"fd":7}}
{"write_memfd":{"fd":8}}
{"write_memfd":{"fd":9}}
{"write_memfd":{"fd":10}}
{"write_memfd":{"fd":11}}
{"write_memfd":{"fd":12}}
{"mark_tainted":{"game":"G"}}

