# EasyPlay in the background (ADR-0022): the library and the application service stay
# loaded, so a Windows program opened from the file manager starts at once and windows open
# without a cold start. Off by default; turn it on with
#     systemctl --user enable --now easyplay.service
# (or programs.easyplay.backgroundService.enable on NixOS and home-manager).
[Unit]
Description=EasyPlay in the background
Documentation=man:easyplay(1)
# Windows need the session's display; the session's end stops the service.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# Packages and the tarball installer rewrite this path to where the binary is installed.
ExecStart=/usr/bin/easyplay service
Restart=on-failure
RestartSec=5
# Games started by the service run in its cgroup under their own supervisors. Stopping or
# restarting the service (an upgrade, `systemctl --user restart`) must not end them.
KillMode=process

[Install]
WantedBy=graphical-session.target
