<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.zaun.Zaun</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Zaun</name>
  <summary>Play Windows games with per-game protection</summary>
  <description>
    <p>
      Zaun runs Windows games on Linux through umu-launcher and Proton. Double-click an
      .exe and play: every game runs inside its own sandbox with its own private Windows
      storage, and only sees its own folder unless you allow more.
    </p>
    <ul>
      <li>Open a game from your file manager, or drop it on the window</li>
      <li>Protection presets: offline, online and standard, adjustable per game</li>
      <li>Play time statistics that never leave your computer</li>
      <li>Compatibility layers kept up to date, with game fixes from the umu database</li>
    </ul>
    <p>
      Zaun has no telemetry and contacts no server unless you turn on online artwork.
    </p>
  </description>
  <launchable type="desktop-id">io.github.zaun.Zaun.desktop</launchable>
  <provides>
    <binary>zaun</binary>
    <mediatype>application/x-msdownload</mediatype>
    <mediatype>application/vnd.microsoft.portable-executable</mediatype>
  </provides>
  <url type="homepage">https://github.com/abdulrahman1s/zaun</url>
  <url type="bugtracker">https://github.com/abdulrahman1s/zaun/issues</url>
  <developer id="io.github.zaun">
    <name>Zaun contributors</name>
  </developer>
  <categories>
    <category>Game</category>
  </categories>
  <keywords>
    <keyword>windows</keyword>
    <keyword>exe</keyword>
    <keyword>proton</keyword>
    <keyword>wine</keyword>
    <keyword>sandbox</keyword>
  </keywords>
